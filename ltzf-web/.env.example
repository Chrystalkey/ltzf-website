# LTZF Website Environment Variables

# API Configuration
PUBLIC_API_URL=https://api.pazufa.de
LTZF_API_KEY=

# Site Configuration
PUBLIC_SITE_URL=https://pazufa.de
PUBLIC_SITE_NAME="Landtagszusammenfasser"
PUBLIC_SITE_DESCRIPTION="Übersicht über Gesetzgebungsverfahren in Deutschland"

# Build Configuration
# Set to 'true' to force refresh all data from API (ignore cache)
BUILD_FORCE_REFRESH=false

# Cache directory (relative to project root)
BUILD_CACHE_DIR=.cache/api

# Cache TTL in seconds (default: 3600 = 1 hour)
BUILD_CACHE_TTL=3600
