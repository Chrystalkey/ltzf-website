---
/**
 * VorgangLayout - Layout for legislative process detail pages
 * Displays a Vorgang (legislative proposal) with all its details
 */
import BaseLayout from './BaseLayout.astro';
import { getBundesland, getVorgangstypLabel, formatDate } from '@lib/constants.js';

interface Props {
    vorgang: any; // Type from API model
}

const { vorgang } = Astro.props;

if (!vorgang) {
    throw new Error('Vorgang data is required');
}

// Get parlament from stationen if not directly available
const parlament = vorgang.parlament || vorgang.stationen?.[0]?.gremium?.parlament;
const bundesland = getBundesland(parlament);

// Use kurztitel for page title if available, otherwise full titel
const displayTitle = vorgang.kurztitel || vorgang.titel;
const title = `${displayTitle} - ${bundesland?.name || parlament}`;
const description = vorgang.zusammenfassung?.slice(0, 160) || vorgang.titel;

// Build breadcrumbs
const breadcrumbs = [
    { label: bundesland?.name || parlament, href: `/ltzf-${parlament}` },
    { label: 'Gesamtübersicht', href: `/ltzf-${parlament}/gesamtuebersicht` },
    { label: displayTitle }
];
---

<BaseLayout title={title} description={description} className="vorgang-page">
    <div class="container">
        <!-- Breadcrumbs -->
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Start</a></li>
                {breadcrumbs.map((crumb, index) => (
                    <li>
                        {crumb.href ? (
                            <a href={crumb.href}>{crumb.label}</a>
                        ) : (
                            <span aria-current="page">{crumb.label}</span>
                        )}
                    </li>
                ))}
            </ol>
        </nav>

        <!-- Vorgang Header -->
        <article class="vorgang-article">
            <header class="vorgang-header">
                <div class="vorgang-meta">
                    <span class="vorgang-type">{vorgang.typ?.label || getVorgangstypLabel(vorgang.vorgangstyp) || 'Vorgang'}</span>
                    <span class="separator">•</span>
                    <span class="vorgang-parlament">{bundesland?.fullName || parlament}</span>
                    {vorgang.wahlperiode && (
                        <>
                            <span class="separator">•</span>
                            <span class="vorgang-wahlperiode">{vorgang.wahlperiode}. Wahlperiode</span>
                        </>
                    )}
                </div>
                <h1>{displayTitle}</h1>
                {vorgang.kurztitel && vorgang.titel !== vorgang.kurztitel && (
                    <p class="vorgang-full-title">{vorgang.titel}</p>
                )}
                {vorgang.zp_modifiziert && (
                    <p class="vorgang-date">
                        Zuletzt aktualisiert: {formatDate(vorgang.zp_modifiziert)}
                    </p>
                )}
            </header>

            <!-- Main Content Slot -->
            <div class="vorgang-content">
                <slot />
            </div>

            <!-- Metadata Footer -->
            <footer class="vorgang-footer">
                {vorgang.api_id && (
                    <p class="vorgang-id">
                        <small>ID: {vorgang.api_id}</small>
                    </p>
                )}
            </footer>
        </article>
    </div>
</BaseLayout>

<style>
    .breadcrumbs {
        margin-bottom: var(--spacing-md);
        font-size: 0.9rem;
    }

    .breadcrumbs ol {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: var(--spacing-xs);
        flex-wrap: wrap;
    }

    .breadcrumbs li {
        display: flex;
        align-items: center;
    }

    .breadcrumbs li:not(:last-child)::after {
        content: '›';
        margin-left: var(--spacing-xs);
        color: var(--color-text-light);
    }

    .breadcrumbs a {
        color: var(--color-primary);
        text-decoration: none;
    }

    .breadcrumbs a:hover {
        text-decoration: underline;
    }

    .breadcrumbs span {
        color: var(--color-text-light);
    }

    .vorgang-article {
        background: white;
        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);
        overflow: hidden;
    }

    .vorgang-header {
        padding: var(--spacing-lg);
        border-bottom: 1px solid var(--color-border);
        background: var(--color-bg-alt);
    }

    .vorgang-meta {
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        margin-bottom: var(--spacing-sm);
        font-size: 0.9rem;
        color: var(--color-text-light);
        flex-wrap: wrap;
    }

    .vorgang-type {
        background: var(--color-primary);
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: var(--border-radius);
        font-weight: 600;
        font-size: 0.85rem;
    }

    .separator {
        color: var(--color-border);
    }

    .vorgang-header h1 {
        margin: 0;
        font-size: 1.75rem;
        line-height: 1.3;
        color: var(--color-text);
    }

    .vorgang-full-title {
        margin: var(--spacing-sm) 0 0;
        font-size: 1rem;
        color: var(--color-text-light);
        font-style: italic;
        line-height: 1.4;
    }

    .vorgang-date {
        margin: var(--spacing-sm) 0 0;
        font-size: 0.9rem;
        color: var(--color-text-light);
    }

    .vorgang-content {
        padding: var(--spacing-lg);
    }

    .vorgang-footer {
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--color-bg-alt);
        border-top: 1px solid var(--color-border);
    }

    .vorgang-id {
        margin: 0;
        color: var(--color-text-light);
    }

    @media (max-width: 768px) {
        .vorgang-header h1 {
            font-size: 1.5rem;
        }

        .vorgang-header,
        .vorgang-content,
        .vorgang-footer {
            padding: var(--spacing-md);
        }
    }
</style>
