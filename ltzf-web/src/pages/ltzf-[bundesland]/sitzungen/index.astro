---
/**
 * Sitzungen List Page
 * Shows all sessions for a specific Bundesland
 */
import LtzfLayout from '@layouts/LtzfLayout.astro';
import SitzungCard from '@components/SitzungCard.astro';
import SearchFilter from '@components/SearchFilter.astro';
import { getAllSitzungen } from '@lib/data-fetcher.js';
import { BUNDESLAENDER, getStateCodes, getFederalCodes } from '@lib/constants.js';

export async function getStaticPaths() {
    const allCodes = [...getStateCodes(), ...getFederalCodes().filter(c => c !== 'BT')];

    return allCodes.map(code => ({
        params: { bundesland: code }
    }));
}

const { bundesland } = Astro.params;

if (!BUNDESLAENDER[bundesland]) {
    return Astro.redirect('/404');
}

const land = BUNDESLAENDER[bundesland];

// Fetch all sitzungen for this Bundesland
const sitzungenRaw = await getAllSitzungen({ parlament: bundesland });
const sitzungen = Array.isArray(sitzungenRaw) ? sitzungenRaw : [];

console.log(`[${bundesland} Sitzungen] Found ${sitzungen.length} sitzungen`);

// Sort by date (newest first)
const sortedSitzungen = sitzungen.sort((a, b) => {
    const dateA = new Date(a.datum || 0);
    const dateB = new Date(b.datum || 0);
    return dateB - dateA;
});
---

<LtzfLayout
    title={`Sitzungen - ${land.name}`}
    description={`Alle Plenarsitzungen des ${land.fullName}`}
    bundeslandCode={bundesland}
    currentPage="sitzungen"
>
    <div class="page-content">
        <header class="page-header">
            <h1>Sitzungen</h1>
            <p class="page-description">
                Alle Plenarsitzungen des {land.fullName}
            </p>
        </header>

        <section class="section">
            <h2>Alle Sitzungen ({sortedSitzungen.length})</h2>

            {sortedSitzungen.length > 0 ? (
                <div class="sitzung-list">
                    {sortedSitzungen.map((sitzung) => (
                        <div class="sitzung-item">
                            <SitzungCard sitzung={sitzung} />
                        </div>
                    ))}
                </div>
            ) : (
                <div class="empty-state">
                    <p>Keine Sitzungen gefunden.</p>
                </div>
            )}
        </section>
    </div>
</LtzfLayout>

<style>
    .page-header {
        margin-bottom: var(--spacing-xl);
    }

    .page-header h1 {
        font-size: 2.5rem;
        margin: 0 0 var(--spacing-sm);
        color: var(--color-primary);
    }

    .page-description {
        font-size: 1.1rem;
        color: var(--color-text-light);
        margin: 0;
    }

    .section {
        margin-bottom: var(--spacing-xl);
    }

    .section h2 {
        font-size: 1.75rem;
        margin: 0 0 var(--spacing-lg);
        color: var(--color-text);
    }

    .sitzung-list {
        display: grid;
        gap: var(--spacing-md);
    }

    .empty-state {
        text-align: center;
        padding: var(--spacing-xl);
        background: var(--color-bg-alt);
        border-radius: var(--border-radius);
        color: var(--color-text-light);
    }

    @media (max-width: 768px) {
        .page-header h1 {
            font-size: 2rem;
        }
    }
</style>
