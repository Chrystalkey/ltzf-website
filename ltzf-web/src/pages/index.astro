---
/**
 * Landing Page - Main entry point
 * Shows overview of federal and state parliaments with recent activity
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import BundeslandSelector from '@components/BundeslandSelector.astro';
import VorgangCard from '@components/VorgangCard.astro';
import Statistics from '@components/Statistics.astro';
import { getAllVorgaenge, calculateStatistics } from '@lib/data-fetcher.js';
import { BUNDESLAENDER, getStateCodes, getFederalCodes } from '@lib/constants.js';

// Fetch recent vorgänge for overview
const allVorgaengeRaw = await getAllVorgaenge();
const allVorgaenge = Array.isArray(allVorgaengeRaw) ? allVorgaengeRaw : [];

console.log(`[Index] Found ${allVorgaenge.length} total vorgänge`);

// Calculate statistics
const stats = calculateStatistics(allVorgaenge);

// Get most recent vorgänge across all parliaments
const recentVorgaenge = allVorgaenge
    .sort((a, b) => {
        const dateA = new Date(a.zp_modifiziert || 0);
        const dateB = new Date(b.zp_modifiziert || 0);
        return dateB - dateA;
    })
    .slice(0, 12);

// Build statistics for display
const displayStats = [
    {
        label: 'Gesetzesvorhaben gesamt',
        value: stats.total,
        description: 'Alle erfassten Vorgänge'
    },
    {
        label: 'Bundestag',
        value: stats.byParlament['BT'] || 0,
        description: 'Vorgänge im Bundestag'
    },
    {
        label: 'Landtage',
        value: Object.entries(stats.byParlament)
            .filter(([key]) => !['BT', 'BR', 'BV', 'EK'].includes(key))
            .reduce((sum, [, count]) => sum + count, 0),
        description: 'Vorgänge in allen Landtagen'
    }
];
---

<BaseLayout
    title="Parlamentszusammenfasser - Deutsche Gesetzgebung im Überblick"
    description="Verfolgen Sie die Gesetzgebung in Bundestag und Landtagen. Aktuelle Entwürfe, Beschlüsse und parlamentarische Vorgänge übersichtlich dargestellt."
>
    <div class="container">
        <!-- Hero Section -->
        <section class="hero">
            <h1>Parlamentszusammenfasser</h1>
            <p class="hero-subtitle">
                Deutsche Gesetzgebung transparent und übersichtlich
            </p>
            <p class="hero-description">
                Verfolgen Sie die Gesetzgebung in Bundestag und allen 16 Landtagen.
                Alle parlamentarischen Vorgänge, Entwürfe und Beschlüsse an einem Ort.
            </p>
        </section>

        <!-- Statistics Overview -->
        <section class="section">
            <Statistics title="Aktuelle Übersicht" stats={displayStats} />
        </section>

        <!-- Bundesland Selector -->
        <section class="section">
            <div class="selector-section">
                <h2>Parlament auswählen</h2>
                <BundeslandSelector showFederal={true} />
            </div>
        </section>

        <!-- Quick Links -->
        <section class="section">
            <h2>Schnellzugriff</h2>
            <div class="quick-links">
                <a href="/btzf" class="quick-link-card">
                    <h3>Bundestag</h3>
                    <p>Bundesgesetzgebung und parlamentarische Vorgänge</p>
                </a>
                <a href="/ltzf-overview" class="quick-link-card">
                    <h3>Länder-Übersicht</h3>
                    <p>Statistiken und Vergleiche aller Landtage</p>
                </a>
            </div>

            <div class="state-links">
                <h3>Landtage</h3>
                <div class="state-grid">
                    {getStateCodes().map(code => {
                        const land = BUNDESLAENDER[code];
                        return (
                            <a href={`/ltzf-${code}`} class="state-link">
                                {land.name}
                            </a>
                        );
                    })}
                </div>
            </div>
        </section>

        <!-- Recent Activity -->
        <section class="section">
            <h2>Neueste Aktivitäten</h2>
            <p class="section-subtitle">
                Die zuletzt aktualisierten Gesetzesvorhaben aus allen Parlamenten
            </p>
            <div class="vorgang-grid">
                {recentVorgaenge.map(vorgang => (
                    <VorgangCard vorgang={vorgang} showParlament={true} />
                ))}
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .hero {
        text-align: center;
        padding: var(--spacing-xl) 0;
        border-bottom: 2px solid var(--color-border);
        margin-bottom: var(--spacing-xl);
    }

    .hero h1 {
        font-size: 2.5rem;
        margin: 0 0 var(--spacing-md);
        color: var(--color-primary);
    }

    .hero-subtitle {
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 var(--spacing-md);
        color: var(--color-text);
    }

    .hero-description {
        font-size: 1.1rem;
        max-width: 800px;
        margin: 0 auto;
        color: var(--color-text-light);
        line-height: 1.6;
    }

    .section {
        margin-bottom: var(--spacing-xl);
    }

    .section h2 {
        font-size: 2rem;
        margin: 0 0 var(--spacing-md);
        color: var(--color-text);
    }

    .section-subtitle {
        font-size: 1rem;
        color: var(--color-text-light);
        margin: 0 0 var(--spacing-lg);
    }

    .selector-section {
        background: white;
        padding: var(--spacing-lg);
        border-radius: var(--border-radius);
        border: 1px solid var(--color-border);
    }

    .selector-section h2 {
        margin-top: 0;
        font-size: 1.5rem;
    }

    .quick-links {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-xl);
    }

    .quick-link-card {
        display: block;
        padding: var(--spacing-lg);
        background: white;
        border: 2px solid var(--color-primary);
        border-radius: var(--border-radius);
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
    }

    .quick-link-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 16px rgba(0, 102, 204, 0.2);
    }

    .quick-link-card h3 {
        margin: 0 0 var(--spacing-sm);
        color: var(--color-primary);
        font-size: 1.5rem;
    }

    .quick-link-card p {
        margin: 0;
        color: var(--color-text-light);
    }

    .state-links {
        background: var(--color-bg-alt);
        padding: var(--spacing-lg);
        border-radius: var(--border-radius);
    }

    .state-links h3 {
        margin: 0 0 var(--spacing-md);
        font-size: 1.25rem;
    }

    .state-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: var(--spacing-sm);
    }

    .state-link {
        display: block;
        padding: var(--spacing-sm) var(--spacing-md);
        background: white;
        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);
        text-decoration: none;
        color: var(--color-text);
        text-align: center;
        transition: all 0.2s ease;
    }

    .state-link:hover {
        background: var(--color-primary);
        color: white;
        border-color: var(--color-primary);
    }

    .vorgang-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: var(--spacing-md);
    }

    @media (max-width: 768px) {
        .hero h1 {
            font-size: 2rem;
        }

        .hero-subtitle {
            font-size: 1.25rem;
        }

        .hero-description {
            font-size: 1rem;
        }

        .vorgang-grid {
            grid-template-columns: 1fr;
        }

        .state-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        }
    }
</style>
